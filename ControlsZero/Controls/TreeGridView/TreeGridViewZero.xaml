<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
		xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
		xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
		xmlns:cz="clr-namespace:FunctionZero.Maui.Controls"
		x:Class="FunctionZero.Maui.Controls.TreeGridViewZero"
	x:Name="Self"
	>
	<cz:GridViewZero 
		x:Name="TheGridView"
		HorizontalOptions="Fill"
		VerticalOptions="Fill"
		ItemHeight="{Binding ItemHeight, Source={x:Reference Self}}" ColumnSpacing="{Binding ColumnSpacing, Source={x:Reference Self}}" DividerColor="{Binding DividerColor, Source={x:Reference Self}}" HeaderVisible="{Binding HeaderVisible, Source={x:Reference Self}}"
		ScrollOffset="{Binding ScrollOffset, Source={x:Reference Self}, Mode=TwoWay}"
		SelectedItem="{Binding SelectedItem, Source={x:Reference Self}, Mode=TwoWay}"
		SelectionMode="{Binding SelectionMode, Source={x:Reference Self}, Mode=TwoWay}"
		SelectedItems="{Binding SelectedItems, Source={x:Reference Self}, Mode=TwoWay}"
		RowStyle="{Binding ItemContainerStyle, Source={x:Reference Self}}"
	>
		<cz:GridColumnZero 
			IsTreeColumn="True" Header="{Binding TreeColumnHeader, Source={x:Reference Self}}" Width="{Binding TreeColumnWidth, Source={x:Reference Self}}"
			ItemTemplate="{Binding TreeItemTemplate, Source={x:Reference Self}}"
			IndentMultiplier="{Binding IndentMultiplier, Source={x:Reference Self}}"
		/>
	</cz:GridViewZero>
</ContentView>
