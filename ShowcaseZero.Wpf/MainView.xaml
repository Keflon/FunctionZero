<Window x:Class="ShowcaseZero.Wpf.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:z="clr-namespace:FunctionZero.Wpf.zBind.z;assembly=FunctionZero.Wpf.BindZero"
        Title="BindZero · WPF Motion Lab"
        Width="1080"
        Height="720"
        MinWidth="860"
        MinHeight="600"
        Background="#080B18"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <local:MainViewVm xmlns:local="clr-namespace:ShowcaseZero.Wpf" />
    </Window.DataContext>

    <Window.Resources>
        <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E61A2140" Offset="0" />
            <GradientStop Color="#C60E1228" Offset="1" />
        </LinearGradientBrush>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
            <Setter Property="Foreground" Value="#F4F6FF" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
    </Window.Resources>

    <Grid ClipToBounds="True">
        <Ellipse Width="620" Height="620" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-260,-330,0,0" Opacity="0.22">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#7C5CFF" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="760" Height="760" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-390,-430" Opacity="0.24">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#16D9E3" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid Margin="48,36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="26" CornerRadius="24" Background="{StaticResource PanelBrush}" BorderBrush="#354068" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="B I N D Z E R O" FontSize="13" FontWeight="SemiBold" Foreground="#8D9BFF" />
                    <TextBlock Text="WPF Motion Lab" FontSize="32" FontWeight="Bold" Margin="0,8,0,6" />
                    <TextBlock Text="Live expressions transform every frame. Adjust the controls and watch element properties flow through z:Bind."
                               FontSize="14" Foreground="#AEB7D3" TextWrapping="Wrap" LineHeight="21" />

                    <Border Margin="0,28,0,24" Padding="16,12" CornerRadius="14" Background="#151B35">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="FRAME" VerticalAlignment="Center" FontSize="12" Foreground="#7783A8" />
                            <TextBlock Grid.Column="1" Text="{Binding Counter}" FontFamily="Cascadia Mono" FontSize="24" FontWeight="SemiBold" Foreground="#65E8FF" />
                        </Grid>
                    </Border>

                    <TextBlock Text="AMPLITUDE" FontSize="12" FontWeight="SemiBold" Foreground="#B8C1DE" />
                    <Slider x:Name="AmplitudeSlider" Minimum="20" Maximum="140" Value="82" TickFrequency="10" />
                    <TextBlock HorizontalAlignment="Right" FontFamily="Cascadia Mono" FontSize="13" Foreground="#65E8FF"
                               Text="{z:Bind Expression=Value, Source={x:Reference AmplitudeSlider}}" />

                    <TextBlock Text="LIVE LINK" Margin="0,24,0,8" FontSize="12" FontWeight="SemiBold" Foreground="#B8C1DE" />
                    <ToggleButton x:Name="GlowToggle" IsChecked="True" Height="44" Padding="14,0" HorizontalContentAlignment="Center"
                                  Content="Toggle satellite glow" Foreground="White" Background="#28325D" BorderBrush="#52639A" />

                    <Border Margin="0,26,0,0" Padding="14" CornerRadius="12" Background="#10152B"
                            IsEnabled="{z:Bind Expression=IsChecked, Source={x:Reference GlowToggle}}">
                        <TextBlock Text="This panel's IsEnabled property is bound directly to the toggle above."
                                   TextWrapping="Wrap" FontSize="12" Foreground="#AEB7D3" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" CornerRadius="30" Background="#B00C1024" BorderBrush="#2F3963" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Canvas ClipToBounds="True">
                        <Ellipse Canvas.Left="70" Canvas.Top="65" Width="420" Height="420" Stroke="#1CDAF2" StrokeThickness="1" Opacity="0.16" />
                        <Ellipse Canvas.Left="130" Canvas.Top="125" Width="300" Height="300" Stroke="#8E71FF" StrokeThickness="1" Opacity="0.2" />

                        <Ellipse Width="{z:Bind Expression='Value * 0.55', Source={x:Reference AmplitudeSlider}}"
                                 Height="{z:Bind Expression='Value * 0.55', Source={x:Reference AmplitudeSlider}}"
                                 Canvas.Left="{z:Bind Expression='270 + Cos((Double)Counter / 17) * 82'}"
                                 Canvas.Top="{z:Bind Expression='240 + Sin((Double)Counter / 17) * 82'}"
                                 Opacity="{z:Bind Expression='0.35 + Value / 220', Source={x:Reference AmplitudeSlider}}"
                                 IsEnabled="{z:Bind Expression=IsChecked, Source={x:Reference GlowToggle}}">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#FFFFFF" Offset="0" />
                                    <GradientStop Color="#65E8FF" Offset="0.22" />
                                    <GradientStop Color="#007CFF" Offset="0.65" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <TextBlock Text="FunctionZero" FontSize="54" FontWeight="Bold" Foreground="White"
                                   Canvas.Left="112" Canvas.Top="225" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#785CFF" BlurRadius="28" ShadowDepth="0" Opacity="0.85" />
                            </TextBlock.Effect>
                            <TextBlock.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="{z:Bind Expression='1 + Sin((Double)Counter / 13) * 0.12'}"
                                                    ScaleY="{z:Bind Expression='1 + Cos((Double)Counter / 15) * 0.12'}" />
                                    <RotateTransform Angle="{z:Bind Expression='Sin((Double)Counter / 21) * 9'}" />
                                    <TranslateTransform X="{z:Bind Expression='Cos((Double)Counter / 18) * 27'}"
                                                        Y="{z:Bind Expression='Sin((Double)Counter / 14) * 20'}" />
                                </TransformGroup>
                            </TextBlock.RenderTransform>
                        </TextBlock>

                        <TextBlock Text="E X P R E S S I O N - D R I V E N   X A M L" FontSize="13" FontWeight="SemiBold" Foreground="#71DCEC"
                                   Canvas.Left="125" Canvas.Top="304" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="{z:Bind Expression='Cos((Double)Counter / 24) * -5'}" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Canvas>

                    <Border Grid.Row="1" Margin="24" Padding="18,14" CornerRadius="16" Background="#B8171D36">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="10" Height="10" Fill="#65E8FF" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="1" Text="Sin + Cos · Rotate · Scale · Translate" FontSize="13" Foreground="#BFC8E7" />
                            <TextBlock Grid.Column="2" Text="60 Hz" FontFamily="Cascadia Mono" FontWeight="SemiBold" Foreground="#8E71FF" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
